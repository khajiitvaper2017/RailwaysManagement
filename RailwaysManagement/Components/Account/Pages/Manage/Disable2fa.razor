@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using RailwaysManagement.DbModels

@inject UserManager<RailwaysManagementUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Вимкнення двофакторної автентифікації (2FA)</PageTitle>

<StatusMessage />
<h3>Вимкнення двофакторної автентифікації (2FA)</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ця дія лише вимикає 2FA.</strong>
    </p>
    <p>
        Вимкнення 2FA не змінює ключі, які використовуються в додатках автентифікатора. Якщо ви бажаєте змінити ключ,
        який використовується в додатку автентифікатора, вам слід <a href="Account/Manage/ResetAuthenticator">скинути ключі автентифікатора.</a>
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Вимкнути 2FA</button>
    </form>
</div>

@code {
    private RailwaysManagementUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Неможливо вимкнути 2FA для користувача, оскільки вона наразі не увімкнена.");
        }
    }

    private async Task OnSubmitAsync()
    {
        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Виникла неочікувана помилка під час вимкнення 2FA.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("Користувач з ID '{UserId}' вимкнув 2FA.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "2FA було вимкнено. Ви можете повторно увімкнути 2FA, коли налаштуєте додаток автентифікатора.",
            HttpContext);
    }
}
