@page "/trains"

@using Microsoft.EntityFrameworkCore
@using RailwaysManagement.DbModels
@using Microsoft.AspNetCore.Components.QuickGrid

@implements IAsyncDisposable
@inject IDbContextFactory<RailwaysDbContext> DbFactory

<PageTitle>Потяги</PageTitle>
<h1>Потяги</h1>

<div class="mb-3">
    <a href="trains/create" class="btn btn-primary" title="Додати новий потяг">Додати новий потяг</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th class="text-center align-middle">Назва</th>
                <th class="text-center align-middle">Максимальна кількість вагонів</th>
                <th class="text-center align-middle">Станція</th>
                <th class="text-center align-middle">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var train in trains)
            {
                <tr>
                    <td class="align-middle">@train.Name</td>
                    <td class="text-center align-middle">@train.MaxCarsCount</td>
                    <td class="align-middle">@train.Station.Name</td>
                    <td class="text-center align-middle">
                        <div class="btn-group" role="group">
                            <a href="@($"trains/details?id={train.Id}")" class="btn btn-info btn-sm" title="Деталі потяга">Деталі</a>
                            <a href="@($"trains/edit?id={train.Id}")" class="btn btn-warning btn-sm" title="Редагувати потяг">Редагувати</a>
                            <a href="@($"trains/delete?id={train.Id}")" class="btn btn-danger btn-sm" title="Видалити потяг">Видалити</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private RailwaysDbContext context = default!;
    private List<Train> trains = new();

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        trains = context.Trains
            .Include(t => t.Station)
            .ToList();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}