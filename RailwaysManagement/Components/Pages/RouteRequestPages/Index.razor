@page "/routerequests"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@using RailwaysManagement.DbModels
@using RailwaysManagement.Services

@implements IAsyncDisposable
@inject IDbContextFactory<RailwaysDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<RailwaysManagementUser> UserManager
@inject NavigationManager NavigationManager
@inject RoutingService RoutingService
<PageTitle>
	Запити на маршрути
</PageTitle>
<h1>Запити на маршрути</h1>

<div class="mb-3">
	<a href="routerequests/create" class="btn btn-primary">Створити новий</a>
</div>

<AuthorizeView Roles="Admin">
	<Authorized>
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead>
					<tr>
						<th class="text-center align-middle">Відправник</th>
						<th class="text-center align-middle">Отримувач</th>
						<th class="text-center align-middle">Дата відвантаження</th>
						<th class="text-center align-middle">Термін доставки</th>
						<th class="text-center align-middle">Кількість вагонів</th>
						<th class="text-center align-middle">Заплановано</th>
						<th class="text-center align-middle">Виконано</th>
						<th class="text-center align-middle">Дії</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var routerequest in routeRequests)
					{
						<tr>
							<td class="text-center align-middle">
								@routerequest.SenderClient.Name <br>@routerequest.SenderClient.Email
							</td>
							<td class="text-center align-middle">
								@routerequest.ReceiverClient.Name <br>@routerequest.ReceiverClient.Email
							</td>
							<td class="text-center align-middle">
								@routerequest.ShipmentDate?.ToString("yyyy-MM-dd")
							</td>
							<td class="text-center align-middle">
								@routerequest.DeliveryDeadlineDate.ToString("yyyy-MM-dd")
							</td>
							<td class="text-center align-middle">
								@routerequest.Cargos.Sum(c => c.WagonsCount)
							</td>
							<td class="text-center align-middle">
								@if (routerequest.IsPlanned)
								{
									<span class="badge bg-success">Так</span>
								}
								else
								{
									<span class="badge bg-danger">Ні</span>
								}
							</td>
							<td class="text-center align-middle">
								@if (routerequest.IsCompleted)
								{
									<span class="badge bg-success">Так</span>
								}
								else
								{
									<span class="badge bg-danger">Ні</span>
								}
							</td>
							<td class="text-center align-middle">
								<div class="btn-group" role="group">
									<a href="@($"routerequests/details?id={routerequest.Id}")" class="btn btn-info btn-sm">Деталі</a>
									<a href="@($"routerequests/edit?id={routerequest.Id}")" class="btn btn-warning btn-sm">Редагувати</a>
									<a href="@($"routerequests/delete?id={routerequest.Id}")" class="btn btn-danger btn-sm">Видалити</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</Authorized>
</AuthorizeView>

<AuthorizeView Roles="Client">
	<Authorized>
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead>
					<tr>
						<th class="text-center align-middle">Відправник</th>
						<th class="text-center align-middle">Отримувач</th>
						<th class="text-center align-middle">Дата відвантаження</th>
						<th class="text-center align-middle">Термін доставки</th>
						<th class="text-center align-middle">Кількість вагонів</th>
						<th class="text-center align-middle">Заплановано</th>
						<th class="text-center align-middle">Виконано</th>
						<th class="text-center align-middle">Дії</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var routerequest in routeRequests.Where(r => r.SenderClientId == appUser.Id || r.ReceiverClientId == appUser.Id))
					{
						<tr>
							<td class="text-center align-middle">
								@routerequest.SenderClient.Name <br>@routerequest.SenderClient.Email
							</td>
							<td class="text-center align-middle">
								@routerequest.ReceiverClient.Name <br>@routerequest.ReceiverClient.Email
							</td>
							<td class="text-center align-middle">
								@routerequest.ShipmentDate?.ToString("yyyy-MM-dd")
							</td>
							<td class="text-center align-middle">
								@routerequest.DeliveryDeadlineDate.ToString("yyyy-MM-dd")
							</td>
							<td class="text-center align-middle">
								@routerequest.Cargos.Sum(c => c.WagonsCount)
							</td>
							<td class="text-center align-middle">
								@if (routerequest.IsPlanned)
								{
									<span class="badge bg-success">Так</span>
								}
								else
								{
									<span class="badge bg-danger">Ні</span>
								}
							</td>
							<td class="text-center align-middle">
								@if (routerequest.IsCompleted)
								{
									<span class="badge bg-success">Так</span>
								}
								else
								{
									<span class="badge bg-danger">Ні</span>
								}
							</td>
							<td class="text-center align-middle">
								<div class="btn-group" role="group">
									<a href="@($"routerequests/details?id={routerequest.Id}")" class="btn btn-info btn-sm">Деталі</a>
									@if (!routerequest.IsPlanned)
									{
										<a href="@($"routerequests/edit?id={routerequest.Id}")" class="btn btn-warning btn-sm">Редагувати</a>
										<a href="@($"routerequests/delete?id={routerequest.Id}")" class="btn btn-danger btn-sm">Видалити</a>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</Authorized>
</AuthorizeView>

@code {
	private RailwaysManagementUser appUser;
	public ICollection<RouteRequest> routeRequests = new List<RouteRequest>();
	private RailwaysDbContext _dbContext = default!;

	protected override void OnInitialized()
	{
		_dbContext = DbFactory.CreateDbContext();

		appUser = UserManager.GetUserAsync(AuthStateProvider.GetAuthenticationStateAsync().Result.User)
			.GetAwaiter().GetResult();

		routeRequests = _dbContext.RouteRequests
			.Include(r => r.Cargos)
			.Include(r => r.SenderClient)
			.Include(r => r.ReceiverClient)
			.ToList();
	}

	public async ValueTask DisposeAsync() => await _dbContext.DisposeAsync();

	private async Task ProcessRouteRequests()
	{
		await RoutingService.CreateRoutes();
	}

	private void UpdateDates()
	{
		// Move dates two days forward.
		foreach (var request in routeRequests)
		{
			request.ShipmentDate = request.ShipmentDate?.AddDays(2);
			request.DeliveryDeadlineDate = request.DeliveryDeadlineDate.AddDays(2);
		}
		_dbContext.SaveChanges();
	}

}
