@page "/cargos"
@using Microsoft.EntityFrameworkCore
@using RailwaysManagement.DbModels
@implements IAsyncDisposable
@inject IDbContextFactory<RailwaysDbContext> DbFactory

<PageTitle>Вантажі</PageTitle>

<h1>Вантажі</h1>

<div class="mb-3">
    <a href="cargos/create" class="btn btn-primary">Створити новий</a>
</div>

@if (cargos is null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Завантаження...</span>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Назва</th>
                    <th class="text-center align-middle">Відправник</th>
                    <th class="text-center align-middle">Одержувач</th>
                    <th class="text-center align-middle">Кількість вагонів</th>
                    <th class="text-center align-middle">Термін доставки</th>
					<th class="text-center align-middle">Опрацьовано</th>
                    <th class="text-center align-middle">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cargo in cargos)
                {
                    <tr>
                        <td class="align-middle">@cargo.Name</td>
                        <td class="align-middle">@cargo.RouteRequest?.SenderClient?.Name</td>
                        <td class="align-middle">@cargo.RouteRequest?.ReceiverClient?.Name</td>
                        <td class="text-center align-middle">@cargo.WagonsCount</td>
                        <td class="text-center align-middle">
	                        @if (cargo.RouteRequest != null)
	                        {
		                        <a href="@($"routerequests/details?id={cargo.RouteRequest.Id}")" class="text-decoration-none">
			                        @cargo.RouteRequest.DeliveryDeadlineDate.ToString("yyyy-MM-dd")
		                        </a>
	                        }
	                        else
	                        {
		                        <em>None</em>
	                        }
                        </td>
                        <td class="text-center align-middle">
							@if (cargo.RouteRequest.IsPlanned == true)
                            {
                                <span class="badge bg-success">Так</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ні</span>
							}
						</td>
                        <td class="text-center align-middle">
                            <div class="btn-group" role="group">
                                <a href="@($"cargos/details?id={cargo.Id}")" class="btn btn-info btn-sm">Деталі</a>
                                <a href="@($"cargos/edit?id={cargo.Id}")" class="btn btn-warning btn-sm">Редагувати</a>
                                <a href="@($"cargos/delete?id={cargo.Id}")" class="btn btn-danger btn-sm">Видалити</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private RailwaysDbContext context = default!;
    private List<Cargo>? cargos;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        LoadCargos();
    }

    private void LoadCargos()
    {
        cargos = context.Cargos
            .Include(c => c.RouteRequest)
                .ThenInclude(rr => rr.SenderClient)
                    .ThenInclude(sc => sc.AssignedStation)
            .Include(c => c.RouteRequest)
                .ThenInclude(rr => rr.ReceiverClient)
            .ToList();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}