			Console.Error.WriteLine($"Помилка генерації звіту: {ex}");
		}
	}

	private bool IsLocationNearStation(Location location)
	{
		// Check if this location is close to any known station
		const double proximityThresholdKm = 1.0; // 1 kilometer threshold

		foreach (var station in _allStations)
		{
			if (station.Location != null)
			{
				var distance = CalculateDistance(
					location.Latitude,
					location.Longitude,
					station.Location.Latitude,
					station.Location.Longitude);

				if (distance < proximityThresholdKm)
					return true;
			}
		}

		return false;
	}

	private async Task ClearRoutes()
	{
		try
		{
			ProcessingMessage = "Очищення маршрутів...";
			StateHasChanged();

			// First, find all planned route requests
			await using (var context = await DbFactory.CreateDbContextAsync())
			{
				var plannedRequests = await context.RouteRequests
					.Where(rr => rr.IsPlanned && !rr.IsCompleted && !rr.IsDeleted)
					.ToListAsync();

				if (!plannedRequests.Any())
				{
					ProcessingMessage = "Немає запланованих маршрутів для очищення";
					return;
				}

				// Get all active routes
				var activeRoutes = await context.Routes
					.Where(r => !r.IsDeleted)
					.ToListAsync();

				if (!activeRoutes.Any())
				{
					// If no routes but planned requests exist, just reset the requests
					foreach (var request in plannedRequests)
					{
						request.IsPlanned = false;
					}

					await context.SaveChangesAsync();
					ProcessingMessage = $"Скинуто планування для {plannedRequests.Count} запитів";
					return;
				}

				// Now reset the planned status on all requests first
				foreach (var request in plannedRequests)
				{
					request.IsPlanned = false;
				}

				await context.SaveChangesAsync();
			}

			// Then process route deletion in a separate context
			await using (var context = await DbFactory.CreateDbContextAsync())
			{
				// Get all non-deleted routes
				var routes = await context.Routes
					.Where(r => !r.IsDeleted)
					.ToListAsync();

				if (!routes.Any())
				{
					await LoadRoutes();
					return;
				}

				var routeIds = routes.Select(r => r.Id).ToList();

				// Delete route-related records using direct SQL to avoid tracking issues
				// Update the SQL queries to match the correct table structure

				// First delete the join table records since they reference both routes and route parts
				await context.Database.ExecuteSqlRawAsync(
					"DELETE FROM RailRouteRouteParts WHERE RailRouteId IN ({0})",
					string.Join(",", routeIds.Select(id => $"'{id}'")));

				// Get route part IDs that are related to the routes
				var routePartIds = await context.Set<RailRouteRoutePart>()
					.Where(rrp => routeIds.Contains(rrp.RailRouteId))
					.Select(rrp => rrp.RoutePartId)
					.ToListAsync();

				if (routePartIds.Any())
				{
					// Delete route stations associated with these route parts
					await context.Database.ExecuteSqlRawAsync(
						"DELETE FROM RoutePartStations WHERE RoutePartId IN ({0})",
						string.Join(",", routePartIds.Select(id => $"'{id}'")));

					// Delete route parts
					await context.Database.ExecuteSqlRawAsync(
						"DELETE FROM RouteParts WHERE Id IN ({0})",
						string.Join(",", routePartIds.Select(id => $"'{id}'")));
				}

				// Mark routes as deleted
				foreach (var route in routes)
				{
					route.IsDeleted = true;
					route.LastModifiedAtUtc = DateTime.UtcNow;
				}

				await context.SaveChangesAsync();

				// Clear UI selection
				SelectedRoute = null;

				// Refresh the UI
				ProcessingMessage = $"Очищено {routes.Count} маршрутів";
				await LoadRoutes();

				// Clear the map
				await JS.InvokeVoidAsync("mapInterop.clearRoute", "routingMap");
			}
		}
		catch (Exception ex)
		{
			ProcessingMessage = $"Помилка очищення маршрутів: {ex.Message}";
		}
	}
